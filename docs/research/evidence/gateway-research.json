  "findings": [
    {
      "id": "G01",
      "basis": "protocol source",
      "finding": "ContextVM transports MCP in ephemeral 25910, not DVM 5999/6999/7000; no inherited durable job/result guarantee."
    },
    {
      "id": "G02",
      "basis": "source and schema probe",
      "finding": "MCP 2026-07-28 requires per-request metadata, resultType and catalog cache fields; prior-version frames cannot be silently relabeled."
    },
    {
      "id": "G03",
      "basis": "source",
      "finding": "rmcp 3.4.0 implements modern MCP but ProtocolVersion::LATEST remains 2025-11-25; explicitly select version."
    },
    {
      "id": "G04",
      "basis": "source",
      "finding": "ContextVM SDK whole server has unbounded inbound queues and defaults oversized transfer on; application bounded framing selected instead."
    },
    {
      "id": "G05",
      "basis": "source risk, not reproduced defect claim",
      "finding": "ContextVM native worker rewrites request IDs to Nostr event IDs; original-ID/same-author cancellation mapping needs an explicit acceptance case."
    },
    {
      "id": "G06",
      "basis": "CEP-8 source",
      "finding": "Paid authorization is execution permission; CEP-8 does not require replay after result loss and delegates failed-execution remedy. No selected payment bridge."
    },
    {
      "id": "G07",
      "basis": "executed upstream tests",
      "finding": "Signed envelope structure, encrypted round trips, no two-client crosstalk, hostile early-message survival, forged-author refusal, required-encryption refusal and allowlist refusal passed in memory."
    },
    {
      "id": "G08",
      "basis": "schema probe",
      "finding": "Protocol-valid MCP tools/call still admits arbitrary argument objects. BigBrotr resource validation/duplicate-key guards remain application responsibilities."
    }
  ],
  "unproven_release_gates": [
    "Actual BigBrotr handlers and stores",
