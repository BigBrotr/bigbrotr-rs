  "evidence_semantics": {
    "catalog": "Per-call full normalized pg_dump before/after SHA256 in raw report; refused calls preserve exact full dump including ACLs. Initial/installed snapshots append one LF relative to hashed bytes; after.sql includes named-reader grants.",
    "roles": "Server-side fingerprint of all pg_authid rows excluding plaintext verifier, with verifier digest/xmin, all membership rows/xmin and database role settings digests/xmin; no raw credentials exported",
    "concurrency": "Actual two waiting advisory locks, PID/blocking_pids/classid/objid and holder PID recorded before release; exactly one installed and one existing. No complete pg_locks row claim.",
    "faults": "Before-forward and after-complete real protocol COMMIT faults; independent guard presence, full dump rollback and fresh resolution; sessions drain to zero and resource permits return",
    "fixture": "Fixed lab bootstrap secret reused only for separate fresh databases. This does not implement or qualify one-time production credential custody/reservation."
  },
